# Токен авторизации, передаваемый в теле входящего запроса (payload.token)
WEBHOOK_TOKEN=your_webhook_token_here

# Bearer-токен для доступа к API МойСклад
MOYSKLAD_API_TOKEN=your_moysklad_api_token_here

# ID дополнительного поля "Промокод" в МойСклад (типа Справочник)
PROMO_CODE_ATTRIBUTE_ID=your_attribute_id_uuid_here

# ID пользовательского справочника промокодов в МойСклад
CUSTOM_ENTITY_ID=your_custom_entity_id_uuid_here

# Порт сервера (по умолчанию 3000)
PORT=3000
